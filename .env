# Flask core settings
SECRET_KEY=dev-secret-key-change-this-in-production-abc123xyz
DEBUG=False
PORT=7860

# Logging
LOG_LEVEL=DEBUG

# Model
MODEL_PATH=model/house_price_model.pkl

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=50
RATE_LIMIT_PER_DAY=200

# App metadata
APP_NAME=EstateIQ
APP_VERSION=1.0.0
ENVIRONMENT=development